# App
APP_NAME=Arabic Intelligent Knowledge Assistant
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arabic_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_ECHO=false

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arabic_documents
QDRANT_TIMEOUT=30

# PDF indexing limits
MAX_PDF_SIZE_BYTES=52428800
MAX_PDF_PAGES=500

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend
API_BASE_URL=http://127.0.0.1:8000
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Logging
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me-in-production
